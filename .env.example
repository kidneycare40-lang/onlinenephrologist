# Database
DATABASE_URL="postgresql://user:password@localhost:5432/kidneycarecentre"

# NextAuth — generate random secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="GENERATE_WITH: node -e console.log(require('crypto').randomBytes(64).toString('hex'))"

# OAuth Providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
