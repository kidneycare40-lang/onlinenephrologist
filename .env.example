# Supabase
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY="NEVER commit this — server-side only"

# JWT Secret — generate random: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_WITH: node -e console.log(require('crypto').randomBytes(64).toString('hex'))"

# Setup key for initial credential bootstrap (/api/auth/init)
SETUP_KEY="GENERATE_WITH: node -e console.log(require('crypto').randomBytes(32).toString('hex'))"

# OpenAI (server-side only — NEVER expose to browser)
